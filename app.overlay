/*
 * Button for Activity 03. native_sim already provides led0 on gpio0 pin 0.
 * sw0 is gpio0 pin 1 and is active high, same polarity as the LED.
 */

#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
	aliases {
		sw0 = &sw0;
	};

	buttons {
		compatible = "gpio-keys";

		sw0: button_0 {
			gpios = <&gpio0 1 GPIO_ACTIVE_HIGH>;
			zephyr,code = <INPUT_KEY_0>;
		};
	};
};
